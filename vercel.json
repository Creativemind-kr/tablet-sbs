{
  "images": {
    "sizes": [960],
    "formats": ["image/webp"],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      { "protocol": "https", "hostname": "firebasestorage.googleapis.com", "pathname": "/v0/b/tablet-sbs.firebasestorage.app/o/**" },
      { "protocol": "https", "hostname": "i.ytimg.com", "pathname": "/vi/**" }
    ]
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
